++          break;
++        }
++        if (eightBit == VK_FORMAT_UNDEFINED
++         && pSupported[i].format == VK_FORMAT_B8G8R8A8_UNORM)
++          eightBit = VK_FORMAT_B8G8R8A8_UNORM;
++      }
++      if (eightBit != VK_FORMAT_UNDEFINED)

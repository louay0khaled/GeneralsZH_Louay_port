++    }
++#endif
+
     static const std::array<std::pair<VkFormat, VkFormat>, 3> srgbFormatMap = {{
       { VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R8G8B8A8_SRGB },

diff --git a/src/dxvk/dxvk_presenter.cpp b/src/dxvk/dxvk_presenter.cpp
--- a/src/dxvk/dxvk_presenter.cpp
+++ b/src/dxvk/dxvk_presenter.cpp
@@ -580,4 +580,38 @@ namespace dxvk {
 
     VkSurfaceFormatKHR surfaceFormat = pickSurfaceFormat(formats.size(), formats.data(), m_preferredFormat);
+
+#if defined(__ANDROID__)
+    // Android Mali test: the device previously selected
+    // VK_FORMAT_A2B10G10R10_UNORM_PACK32 for the presentation surface.
+    // This is deliberately kept out of D3D9 resource-format selection: the
+    // purpose of this patch is to isolate the WSI/swapchain path.
+    // Prefer standard 8-bit sRGB surface formats when the driver offers them.
+    // The search is restricted to the exact color space already selected by
+    // pickSurfaceFormat(), so this cannot silently mix color-space semantics.
+    if (surfaceFormat.colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR
+     && (surfaceFormat.format == VK_FORMAT_A2B10G10R10_UNORM_PACK32
+      || surfaceFormat.format == VK_FORMAT_A2R10G10B10_UNORM_PACK32)) {
+      for (const auto& candidate : formats) {
+        if (candidate.colorSpace == surfaceFormat.colorSpace
+         && candidate.format == VK_FORMAT_R8G8B8A8_SRGB) {
+          Logger::warn("Presenter: Android WSI test replacing 10-bit A2B10/A2R10 swapchain with R8G8B8A8_SRGB");
+          surfaceFormat = candidate;
+          break;
+        }
+      }
+
+      if (surfaceFormat.format == VK_FORMAT_A2B10G10R10_UNORM_PACK32
+       || surfaceFormat.format == VK_FORMAT_A2R10G10B10_UNORM_PACK32) {
+        for (const auto& candidate : formats) {
+          if (candidate.colorSpace == surfaceFormat.colorSpace
+           && candidate.format == VK_FORMAT_B8G8R8A8_SRGB) {
+            Logger::warn("Presenter: Android WSI test replacing 10-bit A2B10/A2R10 swapchain with B8G8R8A8_SRGB");
+            surfaceFormat = candidate;
+            break;
+          }
+        }
+      }
+    }
+#endif
 
     // Select a present mode for the current sync interval
     if ((status = getSupportedPresentModes(modes)))
       return status;

diff --git a/src/d3d9/d3d9_format.cpp b/src/d3d9/d3d9_format.cpp
--- a/src/d3d9/d3d9_format.cpp
+++ b/src/d3d9/d3d9_format.cpp
@@ -7,14 +7,30 @@ namespace dxvk {
       case D3D9Format::Unknown: return {};
 
       case D3D9Format::R8G8B8: return {}; // Unsupported
 
       case D3D9Format::A8R8G8B8: return {
-        VK_FORMAT_B8G8R8A8_UNORM,
-        VK_FORMAT_B8G8R8A8_SRGB,
-        VK_IMAGE_ASPECT_COLOR_BIT };
+#if defined(__ANDROID__)
+        // Mali-G52 diagnostic: avoid native BGRA sampling and reconstruct
+        // the D3D9 byte order through an explicit component swizzle.
+        VK_FORMAT_R8G8B8A8_UNORM,
+        VK_FORMAT_R8G8B8A8_SRGB,
+        VK_IMAGE_ASPECT_COLOR_BIT,
+        { VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_G,
+          VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_A }};
+#else
+        VK_FORMAT_B8G8R8A8_UNORM,
+        VK_FORMAT_B8G8R8A8_SRGB,
+        VK_IMAGE_ASPECT_COLOR_BIT };
+#endif
 
       case D3D9Format::X8R8G8B8: return {
-        VK_FORMAT_B8G8R8A8_UNORM,
-        VK_FORMAT_B8G8R8A8_SRGB,
-        VK_IMAGE_ASPECT_COLOR_BIT,
-        { VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_G,
-          VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_ONE }};
+#if defined(__ANDROID__)
+        VK_FORMAT_R8G8B8A8_UNORM,
+        VK_FORMAT_R8G8B8A8_SRGB,
+        VK_IMAGE_ASPECT_COLOR_BIT,
+        { VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_G,
+          VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_ONE }};
+#else
+        VK_FORMAT_B8G8R8A8_UNORM,
+        VK_FORMAT_B8G8R8A8_SRGB,
+        VK_IMAGE_ASPECT_COLOR_BIT,
+        { VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_G,
+          VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_ONE }};
+#endif
 
       case D3D9Format::R5G6B5: return {
         VK_FORMAT_R5G6B5_UNORM_PACK16,
         VK_FORMAT_UNDEFINED,
         VK_IMAGE_ASPECT_COLOR_BIT};

+static inline void DecodeBC565(uint16_t c, uint8_t& r, uint8_t& g, uint8_t& b) {
+  r = uint8_t(((c >> 11) & 0x1f) * 255 / 31);
+  g = uint8_t(((c >> 5)  & 0x3f) * 255 / 63);
+  b = uint8_t(( c        & 0x1f) * 255 / 31);
+}
+
+static void DecodeBC1Block(const uint8_t* src, bool alphaMode, uint8_t* dst) {
+  uint16_t c0 = uint16_t(src[0] | (src[1] << 8));
+  uint16_t c1 = uint16_t(src[2] | (src[3] << 8));
+  uint8_t pal[4][4];
+  DecodeBC565(c0, pal[0][0], pal[0][1], pal[0][2]);
+  DecodeBC565(c1, pal[1][0], pal[1][1], pal[1][2]);
+  pal[0][3] = pal[1][3] = 255;
+  bool threeColor = alphaMode && c0 <= c1;
+  if (threeColor) {
+    for (int c = 0; c < 3; c++) pal[2][c] = uint8_t((pal[0][c] + pal[1][c]) / 2);
+    pal[2][3] = 255;
+    pal[3][0] = pal[3][1] = pal[3][2] = pal[3][3] = 0;
+  } else {
+    for (int c = 0; c < 3; c++) {
+      pal[2][c] = uint8_t((2 * pal[0][c] + pal[1][c]) / 3);
+      pal[3][c] = uint8_t((pal[0][c] + 2 * pal[1][c]) / 3);
+    }
+    pal[2][3] = pal[3][3] = 255;
+  }
+  uint32_t indices = uint32_t(src[4]) | (uint32_t(src[5]) << 8)
+                   | (uint32_t(src[6]) << 16) | (uint32_t(src[7]) << 24);
+  for (int i = 0; i < 16; i++) {
+    uint32_t idx = (indices >> (2 * i)) & 3;
+    std::memcpy(dst + i * 4, pal[idx], 4);
+  }
+}
+
+static void DecodeBC3Alpha(const uint8_t* src, uint8_t* alpha) {
+  uint8_t pal[8] = { src[0], src[1] };
+  if (pal[0] > pal[1]) {
+    for (int i = 1; i <= 6; i++)
+      pal[i + 1] = uint8_t(((7 - i) * pal[0] + i * pal[1]) / 7);
+  } else {
+    for (int i = 1; i <= 4; i++)
+      pal[i + 1] = uint8_t(((5 - i) * pal[0] + i * pal[1]) / 5);
+    pal[6] = 0;
+    pal[7] = 255;
+  }
+  uint64_t bits = 0;
+  for (int i = 0; i < 6; i++) bits |= uint64_t(src[2 + i]) << (8 * i);
+  for (int i = 0; i < 16; i++) alpha[i] = pal[(bits >> (3 * i)) & 7];
+}
+
+static bool DecodeDXTLevel(D3D9Format fmt, uint32_t width, uint32_t height,
+                           const uint8_t* src, size_t srcSize,
+                           std::vector<uint8_t>& dst) {
+  const bool dxt1 = fmt == D3D9Format::DXT1;
+  const uint32_t blockBytes = dxt1 ? 8 : 16;
+  const uint32_t blocksX = (width + 3) / 4;
+  const uint32_t blocksY = (height + 3) / 4;
+  const size_t required = size_t(blocksX) * blocksY * blockBytes;
+  if (required > srcSize) return false;
+  dst.resize(size_t(width) * height * 4);
+  for (uint32_t by = 0; by < blocksY; by++) {
+    for (uint32_t bx = 0; bx < blocksX; bx++) {
+      const uint8_t* block = src + (size_t(by) * blocksX + bx) * blockBytes;
+      uint8_t rgba[64];
+      uint8_t alpha[16];
+      if (dxt1) {
+        DecodeBC1Block(block, true, rgba);
+      } else if (fmt == D3D9Format::DXT2 || fmt == D3D9Format::DXT3) {
+        DecodeBC1Block(block + 8, false, rgba);
+        for (int i = 0; i < 16; i++)
+          rgba[i * 4 + 3] = uint8_t(((block[i / 2] >> ((i & 1) * 4)) & 15) * 17);
+      } else {
+        DecodeBC3Alpha(block, alpha);
+        DecodeBC1Block(block + 8, false, rgba);
+        for (int i = 0; i < 16; i++) rgba[i * 4 + 3] = alpha[i];
+      }
+      uint32_t maxX = std::min(4u, width - bx * 4);
+      uint32_t maxY = std::min(4u, height - by * 4);
+      for (uint32_t y = 0; y < maxY; y++)
+        for (uint32_t x = 0; x < maxX; x++)
+          std::memcpy(&dst[(size_t(by * 4 + y) * width + bx * 4 + x) * 4],
+                      &rgba[(y * 4 + x) * 4], 4);
+    }
+  }
+  return true;
+}

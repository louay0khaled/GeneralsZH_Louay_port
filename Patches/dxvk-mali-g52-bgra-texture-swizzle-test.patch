diff --git a/src/d3d9/d3d9_format.cpp b/src/d3d9/d3d9_format.cpp
--- a/src/d3d9/d3d9_format.cpp
+++ b/src/d3d9/d3d9_format.cpp
@@ -7,14 +7,30 @@ namespace dxvk {
       case D3D9Format::Unknown: return {};
 
       case D3D9Format::R8G8B8: return {}; // Unsupported
 
       case D3D9Format::A8R8G8B8: return {
-        VK_FORMAT_B8G8R8A8_UNORM,
-        VK_FORMAT_B8G8R8A8_SRGB,
-        VK_IMAGE_ASPECT_COLOR_BIT };
+#if defined(__ANDROID__)
+        // Mali-G52 diagnostic: avoid native BGRA sampling and reconstruct
+        // the D3D9 byte order through an explicit component swizzle.
+        VK_FORMAT_R8G8B8A8_UNORM,
+        VK_FORMAT_R8G8B8A8_SRGB,
+        VK_IMAGE_ASPECT_COLOR_BIT,
+        { VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_G,
+          VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_A }};
+#else
+        VK_FORMAT_B8G8R8A8_UNORM,
+        VK_FORMAT_B8G8R8A8_SRGB,
+        VK_IMAGE_ASPECT_COLOR_BIT };
+#endif
 
       case D3D9Format::X8R8G8B8: return {
-        VK_FORMAT_B8G8R8A8_UNORM,
-        VK_FORMAT_B8G8R8A8_SRGB,
-        VK_IMAGE_ASPECT_COLOR_BIT,
-        { VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_G,
-          VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_ONE }};
+#if defined(__ANDROID__)
+        VK_FORMAT_R8G8B8A8_UNORM,
+        VK_FORMAT_R8G8B8A8_SRGB,
+        VK_IMAGE_ASPECT_COLOR_BIT,
+        { VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_G,
+          VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_ONE }};
+#else
+        VK_FORMAT_B8G8R8A8_UNORM,
+        VK_FORMAT_B8G8R8A8_SRGB,
+        VK_IMAGE_ASPECT_COLOR_BIT,
+        { VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_G,
+          VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_ONE }};
+#endif
 
       case D3D9Format::R5G6B5: return {
         VK_FORMAT_R5G6B5_UNORM_PACK16,
         VK_FORMAT_UNDEFINED,
         VK_IMAGE_ASPECT_COLOR_BIT};
